{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メイン窓に許す操作。エンジンの起動はアプリ自身のコマンドなので個別の許可は要らない。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:default",
    "store:default",
    "opener:default",
    "updater:default",
    "process:default"
  ]
}
